{
  "openapi": "3.0.3",
  "info": {
    "title": "Indonesia Pipeline Dashboard",
    "description": "Serves a static snapshot dashboard of Ninja Van's Indonesia sales opportunity pipeline.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Readiness probe used by the platform to confirm the backend is up.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The backend is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" }
                  },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    },
    "/{full_path}": {
      "get": {
        "summary": "Serves the static Indonesia opportunity pipeline dashboard page for any path.",
        "operationId": "serve_dashboard",
        "parameters": [
          {
            "name": "full_path",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The dashboard HTML page.",
            "content": {
              "text/html": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
