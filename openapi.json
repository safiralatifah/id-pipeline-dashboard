{
  "openapi": "3.0.3",
  "info": {
    "title": "Indonesia Pipeline Dashboard",
    "description": "Serves a dashboard of Ninja Van's all-time Indonesia sales opportunity pipeline (composition, aging, stage bottlenecks, forecast, team rollups, and Notebook activity), refreshed by a background job roughly every 15 minutes from the Ninja Van SalesCRM API — the full pull is ~73k records, too slow to run inside a request.",
    "version": "3.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Readiness probe used by the platform to confirm the backend is up.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The backend is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" }
                  },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    },
    "/api/pipeline": {
      "get": {
        "summary": "Returns aggregated Indonesia opportunity pipeline metrics from the last completed background refresh (roughly every 15 minutes), optionally filtered. Every metric in the response is recomputed against the filtered population — this isn't a separate filtered view of a fixed payload.",
        "operationId": "get_pipeline",
        "parameters": [
          { "name": "owners", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } }, "description": "Repeatable. Keep only deals (and Tasks) owned by one of these owner_names. OR within this filter." },
          { "name": "managers", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } }, "description": "Repeatable. Keep only deals (and Tasks) whose owner's Manager (per team_roster.json) is one of these. Deals owned by someone not in the roster never match." },
          { "name": "product_lines", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } }, "description": "Repeatable. Keep only deals whose nv_product_line is one of these. Does not filter Tasks." },
          { "name": "service_levels", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } }, "description": "Repeatable. Keep only deals whose service_level (multi-select) includes at least one of these. Does not filter Tasks." }
        ],
        "responses": {
          "200": {
            "description": "Aggregated pipeline metrics.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer", "description": "Every open Indonesia Opportunity (any age) plus any Opportunity created in the last 12 months (open or closed) — not the true all-time count of 72,721, which is too large to fetch per refresh." },
                    "created_this_month": { "type": "integer", "description": "New-business Opportunities (type Acquisition or Cross-Selling) created this calendar month." },
                    "created_last_month": { "type": "integer", "description": "Same Type filter as created_this_month, previous calendar month." },
                    "open_pipeline": { "type": "integer" },
                    "open_active": { "type": "integer" },
                    "open_future": { "type": "integer" },
                    "closed_won": { "type": "integer" },
                    "closed_lost": { "type": "integer" },
                    "closed_total": { "type": "integer" },
                    "pipeline_conversion_pct": { "type": "number", "description": "Closed-Won this month / count of unique deals across (Created this month, Open Pipeline, Closed-Won this month, Closed-Lost this month), deduplicated by id." },
                    "pipeline_conversion_numerator": { "type": "integer" },
                    "pipeline_conversion_denominator": { "type": "integer" },
                    "lead_time_to_won_avg_days": { "type": "number", "nullable": true, "description": "Average days from created_at to the stage change that closed each Closed-Won deal (created_at stands in for a missing 'entered New stage' timestamp). Null if there are no Closed-Won deals in range." },
                    "lead_time_to_won_count": { "type": "integer", "description": "Number of Closed-Won deals included in the lead-time average." },
                    "revenue_potential_mth": { "type": "number" },
                    "revenue_committed_mth": { "type": "number" },
                    "open_stages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "count": { "type": "integer" }
                        }
                      }
                    },
                    "closed_stages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "count": { "type": "integer" }
                        }
                      }
                    },
                    "product_lines": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "count": { "type": "integer" }
                        }
                      }
                    },
                    "service_levels": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "count": { "type": "integer" }
                        }
                      }
                    },
                    "service_blank": { "type": "integer" },
                    "aging_buckets": {
                      "type": "array",
                      "description": "Open deals bucketed by days since creation.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": { "type": "string" },
                          "count": { "type": "integer" }
                        }
                      }
                    },
                    "stage_duration": {
                      "type": "array",
                      "description": "Average days open deals have sat in each current stage, longest first.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "avg_days": { "type": "number" },
                          "count": { "type": "integer" }
                        }
                      }
                    },
                    "stage_duration_buckets": {
                      "type": "array",
                      "description": "Open deals bucketed by days since their last stage change.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": { "type": "string" },
                          "count": { "type": "integer" }
                        }
                      }
                    },
                    "stage_duration_grid": {
                      "type": "array",
                      "description": "For each stage, its open deals broken down by days-since-last-stage-change bucket.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "stage": { "type": "string" },
                          "total": { "type": "integer" },
                          "buckets": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "label": { "type": "string" },
                                "count": { "type": "integer" }
                              }
                            }
                          }
                        }
                      }
                    },
                    "aging_grid": {
                      "type": "array",
                      "description": "For each days-since-creation bucket, open deals broken down by current stage.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": { "type": "string" },
                          "total": { "type": "integer" },
                          "stages": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "name": { "type": "string" },
                                "count": { "type": "integer" }
                              }
                            }
                          }
                        }
                      }
                    },
                    "forecast": {
                      "type": "array",
                      "description": "Open deals by expected close date: a leading 'overdue' bucket (close date already passed), then one bucket per month from the current month through the furthest expected close date in the data. Each bucket is broken down by stage and revenue.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": { "type": "string", "example": "2026-09", "description": "\"overdue\" or a YYYY-MM month key." },
                          "count": { "type": "integer" },
                          "revenue": { "type": "number" },
                          "stages": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "name": { "type": "string" },
                                "count": { "type": "integer" },
                                "revenue": { "type": "number" }
                              }
                            }
                          }
                        }
                      }
                    },
                    "forecast_undated_count": {
                      "type": "integer",
                      "description": "Open deals with no expected close date, excluded from the forecast."
                    },
                    "created_by_month": {
                      "type": "object",
                      "description": "New-business Opportunities (type Acquisition or Cross-Selling) created per month, rolled up by Manager and by individual owner (Active-rep team roster). Each rep has a 10-per-month target; a manager's target is 10 x their headcount. Each row also carries Closed-Won counts for the same months (3-per-month target per rep, not Type-filtered) shown alongside Created.",
                      "properties": {
                        "months": { "type": "array", "items": { "type": "string" }, "description": "Sorted ascending — the last element is the current month." },
                        "by_manager": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": { "type": "string" },
                              "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
                              "total": { "type": "integer" },
                              "target": { "type": "integer", "nullable": true, "description": "10 x headcount reporting to this manager. Null for the 'Unmapped' bucket." },
                              "won_counts": { "type": "object", "additionalProperties": { "type": "integer" }, "description": "Closed-Won opportunities per month, keyed by when the opportunity actually closed (stage_last_changed_at, falling back to updated_at) — not by created_at, and not Type-filtered (matches the Closed-Won This Month summary card, unlike counts above which is new-business only)." },
                              "won_total": { "type": "integer" },
                              "won_target": { "type": "integer", "nullable": true, "description": "3 x headcount reporting to this manager. Null for the 'Unmapped' bucket." }
                            }
                          }
                        },
                        "by_owner": {
                          "type": "array",
                          "description": "One row per Active rep, including reps with 0 created this window.",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": { "type": "string" },
                              "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
                              "total": { "type": "integer" },
                              "target": { "type": "integer", "description": "Always 10." },
                              "won_counts": { "type": "object", "additionalProperties": { "type": "integer" }, "description": "Closed-Won opportunities per month, keyed by when the opportunity actually closed (stage_last_changed_at, falling back to updated_at) — not by created_at, and not Type-filtered." },
                              "won_total": { "type": "integer" },
                              "won_target": { "type": "integer", "description": "Always 3." }
                            }
                          }
                        },
                        "unmapped_owner_count": { "type": "integer" }
                      }
                    },
                    "activity_summary": {
                      "type": "array",
                      "description": "Open deals bucketed by days since their Notebook was last touched (falls back to created_at if never touched). Reps are expected to add a Notebook entry at least every 7 days.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": { "type": "string", "example": "< 7d" },
                          "color": { "type": "string", "example": "good", "description": "good | warning | orange | critical" },
                          "count": { "type": "integer" }
                        }
                      }
                    },
                    "activity_touched_pct": {
                      "type": "number",
                      "description": "Percent of open opportunities whose Notebook was touched within the last 7 days."
                    },
                    "activity_by_owner": {
                      "type": "array",
                      "description": "Per-owner breakdown of the same staleness buckets, sorted worst (most 30d+) first.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
                          "total": { "type": "integer" },
                          "touched_pct": { "type": "number", "description": "This owner's own percent touched within 7 days." }
                        }
                      }
                    },
                    "activity_undated_count": {
                      "type": "integer",
                      "description": "Open deals with neither a Notebook entry nor a created_at (should be ~0)."
                    },
                    "task_total": { "type": "integer", "description": "Open (Not Started / In Progress) Task records owned by reps in the team roster." },
                    "task_active_total": { "type": "integer", "description": "Of task_total, how many were touched (updated_at, falling back to created_at) within the last 7 days and aren't overdue." },
                    "task_activity_pct": { "type": "number" },
                    "task_activity_by_owner": {
                      "type": "array",
                      "description": "Per-owner open Task counts and the same 'active' definition, sorted worst (lowest active_pct) first.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "total": { "type": "integer" },
                          "active": { "type": "integer" },
                          "active_pct": { "type": "number" }
                        }
                      }
                    },
                    "task_unmapped_reps": {
                      "type": "array",
                      "description": "Roster names with no CRM owner_id on file — their Tasks can't be queried at all.",
                      "items": { "type": "string" }
                    },
                    "crm_updated_pct": { "type": "number", "description": "The final Activity KPI: (Notebook <7d count + Task Active count) / (total open deals + total open Tasks), summed rather than averaged." },
                    "crm_updated_numerator": { "type": "integer" },
                    "crm_updated_denominator": { "type": "integer" },
                    "crm_updated_by_owner": {
                      "type": "array",
                      "description": "Per-owner version of crm_updated_pct, sorted worst first.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "updated": { "type": "integer" },
                          "total": { "type": "integer" },
                          "pct": { "type": "number" }
                        }
                      }
                    },
                    "snapshot_at": { "type": "string", "format": "date-time" },
                    "filter_options": {
                      "type": "object",
                      "description": "Dropdown choices for the filter bar, computed from the full unfiltered population — with one exception: owners and managers narrow each other (picking a Manager narrows the owners list to that manager's team, and picking Salespeople narrows the managers list to their managers), based on this request's own owners/managers query params. product_lines and service_levels are unaffected by any filter selection.",
                      "properties": {
                        "owners": { "type": "array", "items": { "type": "string" }, "description": "Narrowed to the selected managers' teams when the managers filter is active." },
                        "managers": { "type": "array", "items": { "type": "string" }, "description": "Includes the synthetic value \"Unmapped\" when at least one matched Opportunity's owner has no team_roster manager (or isn't in the roster at all). Narrowed to the selected owners' own managers when the owners filter is active." },
                        "product_lines": { "type": "array", "items": { "type": "string" } },
                        "service_levels": { "type": "array", "items": { "type": "string" } }
                      }
                    },
                    "viewer_name": { "type": "string", "nullable": true, "description": "The requester's team-roster name, resolved from the platform's X-Forwarded-Email header via a TEAM_EMAIL_MAP env var. Null if unmapped or SSO isn't the access method." },
                    "viewer_scoped": { "type": "boolean", "description": "True if viewer_name was resolved and the response was restricted to their own pipeline (or their team's, if they're a Manager/Sales Head)." },
                    "action_items": {
                      "type": "object",
                      "nullable": true,
                      "description": "Personalized 'needs attention' summary for the Overview tab. Null unless the viewer is identity-scoped OR the request explicitly filtered by Salesperson/Manager (an admin can preview any rep's or manager's view this way) — never present on an unfiltered, unrestricted request.",
                      "properties": {
                        "scope_size": { "type": "integer", "description": "Number of reps in the viewer's roster scope. 1 for an individual rep (or an admin previewing a single Salesperson filter); >1 for a Manager/Sales Head (or an admin previewing one). Drives whether the frontend renders per-deal item examples (1) or a per-rep count breakdown (>1) for each category below." },
                        "overdue": {
                          "type": "object",
                          "description": "Open (non-Future-Opportunity) deals past expected_close_date, worst first.",
                          "properties": {
                            "total": { "type": "integer" },
                            "items": {
                              "type": "array",
                              "description": "Up to 8 example deals, worst first. Rendered only when scope_size is 1.",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": { "type": "integer" },
                                  "name": { "type": "string", "nullable": true },
                                  "crm_url": { "type": "string" },
                                  "owner_name": { "type": "string", "nullable": true },
                                  "days": { "type": "integer", "nullable": true, "description": "Days in the current stage." }
                                }
                              }
                            },
                            "by_owner": {
                              "type": "array",
                              "description": "One row per rep with at least one matching deal, sorted worst-first. Rendered instead of items when scope_size is >1.",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "name": { "type": "string" },
                                  "count": { "type": "integer" },
                                  "items": {
                                    "type": "array",
                                    "description": "This rep's own matching deals (uncapped), same shape as the category's top-level items, worst first.",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "id": { "type": "integer" },
                                        "name": { "type": "string", "nullable": true },
                                        "crm_url": { "type": "string" },
                                        "owner_name": { "type": "string", "nullable": true },
                                        "days": { "type": "integer", "nullable": true }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "stalled": {
                          "type": "object",
                          "description": "Open (non-Future-Opportunity) deals with no stage movement in 30+ days, worst first. Same {total, items, by_owner} shape as overdue.",
                          "properties": {
                            "total": { "type": "integer" },
                            "items": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": { "type": "integer" },
                                  "name": { "type": "string", "nullable": true },
                                  "crm_url": { "type": "string" },
                                  "owner_name": { "type": "string", "nullable": true },
                                  "days": { "type": "integer", "nullable": true }
                                }
                              }
                            },
                            "by_owner": {
                              "type": "array",
                              "description": "One row per rep with at least one matching deal, sorted worst-first. Rendered instead of items when scope_size is >1.",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "name": { "type": "string" },
                                  "count": { "type": "integer" },
                                  "items": {
                                    "type": "array",
                                    "description": "This rep's own matching deals (uncapped), same shape as the category's top-level items, worst first.",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "id": { "type": "integer" },
                                        "name": { "type": "string", "nullable": true },
                                        "crm_url": { "type": "string" },
                                        "owner_name": { "type": "string", "nullable": true },
                                        "days": { "type": "integer", "nullable": true }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "notebook_stale": {
                          "type": "object",
                          "description": "Open (non-Future-Opportunity) deals without a Notebook update in 14+ days, worst first. Same {total, items, by_owner} shape as overdue.",
                          "properties": {
                            "total": { "type": "integer" },
                            "items": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": { "type": "integer" },
                                  "name": { "type": "string", "nullable": true },
                                  "crm_url": { "type": "string" },
                                  "owner_name": { "type": "string", "nullable": true },
                                  "days": { "type": "integer", "nullable": true, "description": "Days since last Notebook touch (or created_at)." }
                                }
                              }
                            },
                            "by_owner": {
                              "type": "array",
                              "description": "One row per rep with at least one matching deal, sorted worst-first. Rendered instead of items when scope_size is >1.",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "name": { "type": "string" },
                                  "count": { "type": "integer" },
                                  "items": {
                                    "type": "array",
                                    "description": "This rep's own matching deals (uncapped), same shape as the category's top-level items, worst first.",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "id": { "type": "integer" },
                                        "name": { "type": "string", "nullable": true },
                                        "crm_url": { "type": "string" },
                                        "owner_name": { "type": "string", "nullable": true },
                                        "days": { "type": "integer", "nullable": true, "description": "Days since last Notebook touch (or created_at)." }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "missing_revenue": {
                          "type": "object",
                          "description": "Open (non-Future-Opportunity) deals with total_potential_revenue_mth or committed_revenue_mth blank on the CRM record (not filled in — an entered 0 doesn't count), sorted by aging_days descending. Same {total, items, by_owner} shape as overdue.",
                          "properties": {
                            "total": { "type": "integer" },
                            "items": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": { "type": "integer" },
                                  "name": { "type": "string", "nullable": true },
                                  "crm_url": { "type": "string" },
                                  "owner_name": { "type": "string", "nullable": true },
                                  "days": { "type": "integer", "nullable": true, "description": "Aging (days since created_at)." }
                                }
                              }
                            },
                            "by_owner": {
                              "type": "array",
                              "description": "One row per rep with at least one matching deal, sorted worst-first. Rendered instead of items when scope_size is >1.",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "name": { "type": "string" },
                                  "count": { "type": "integer" },
                                  "items": {
                                    "type": "array",
                                    "description": "This rep's own matching deals (uncapped), same shape as the category's top-level items, worst first.",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "id": { "type": "integer" },
                                        "name": { "type": "string", "nullable": true },
                                        "crm_url": { "type": "string" },
                                        "owner_name": { "type": "string", "nullable": true },
                                        "days": { "type": "integer", "nullable": true }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "tasks_pending": {
                          "type": "object",
                          "description": "Open Tasks (Not Started / In Progress) that aren't Active by the same rule the Activity panel uses, worst first.",
                          "properties": {
                            "total": { "type": "integer" },
                            "items": {
                              "type": "array",
                              "description": "Up to 8 example tasks, worst first. Rendered only when scope_size is 1.",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": { "type": "integer" },
                                  "subject": { "type": "string" },
                                  "owner_name": { "type": "string", "nullable": true },
                                  "days_since_update": { "type": "integer", "nullable": true },
                                  "crm_url": { "type": "string", "nullable": true, "description": "Null when the Task isn't linked to an Opportunity." }
                                }
                              }
                            },
                            "by_owner": {
                              "type": "array",
                              "description": "One row per rep with at least one matching task, sorted worst-first. Rendered instead of items when scope_size is >1.",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "name": { "type": "string" },
                                  "count": { "type": "integer" },
                                  "items": {
                                    "type": "array",
                                    "description": "This rep's own matching tasks (uncapped), same shape as the category's top-level items, worst first.",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "id": { "type": "integer" },
                                        "subject": { "type": "string" },
                                        "owner_name": { "type": "string", "nullable": true },
                                        "days_since_update": { "type": "integer", "nullable": true },
                                        "crm_url": { "type": "string", "nullable": true }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "monthly_pace": {
                          "type": "array",
                          "description": "Every rep in scope (even at 0 created), sorted most-behind-target first.",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": { "type": "string" },
                              "created": { "type": "integer" },
                              "target": { "type": "integer", "description": "Always 10." }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "502": { "description": "The CRM rejected the API key, or the background refresh's last attempt failed." },
          "503": { "description": "No data cached yet — the background refresh (fetches ~73k records, can take a few minutes) hasn't completed its first run since the app started. Retry shortly." }
        }
      }
    },
    "/api/opportunities": {
      "get": {
        "summary": "Flat per-opportunity rows for the Opportunity List tab — same filters and identity scoping as /api/pipeline, not pre-aggregated.",
        "operationId": "get_opportunities",
        "responses": {
          "200": {
            "description": "One row per matched Opportunity.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer" },
                    "snapshot_at": { "type": "string", "format": "date-time" },
                    "viewer_name": { "type": "string", "nullable": true },
                    "viewer_scoped": { "type": "boolean" },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "integer" },
                          "name": { "type": "string", "nullable": true },
                          "crm_url": { "type": "string", "description": "Direct link to the record in the CRM web app." },
                          "owner_name": { "type": "string", "nullable": true },
                          "manager": { "type": "string", "nullable": true, "description": "From the team roster; \"Unmapped\" if the owner isn't an Active rep on file or has no manager set. Null only when the opportunity has no owner at all." },
                          "stage": { "type": "string" },
                          "stage_group": { "type": "string", "description": "open | future | closed_won | closed_lost — which of the four Opportunity List sections this row belongs to." },
                          "type": { "type": "string", "nullable": true, "description": "Acquisition | Cross-Selling | Pricing | Up-Selling | Regain | Others." },
                          "nv_product_line": { "type": "string", "nullable": true },
                          "service_level": { "type": "array", "items": { "type": "string" } },
                          "created_at": { "type": "string", "format": "date-time" },
                          "aging_days": { "type": "integer", "nullable": true, "description": "Days since created_at — same definition as Deal Aging." },
                          "stage_last_changed_at": { "type": "string", "nullable": true },
                          "last_stage_duration_days": { "type": "integer", "nullable": true, "description": "Days since stage_last_changed_at — same definition as Stage Bottlenecks." },
                          "expected_close_date": { "type": "string", "nullable": true },
                          "overdue": { "type": "boolean", "description": "Open, with an expected_close_date already in the past." },
                          "total_potential_revenue_mth": { "type": "number" },
                          "committed_revenue_mth": { "type": "number" },
                          "revenue_blank": { "type": "boolean", "description": "True when total_potential_revenue_mth or committed_revenue_mth is blank on the CRM record (not filled in at all — an entered 0 doesn't count)." },
                          "notebook_last_touch": { "type": "string", "nullable": true },
                          "notebook_days_since_touch": { "type": "integer", "nullable": true },
                          "notebook_freshness": { "type": "string", "nullable": true, "description": "< 7d | 7-14d | 14-30d | 30d+, same buckets as the Activity panel." },
                          "notebook_content": { "type": "string", "nullable": true, "description": "AI summary of the most recent Notebook entry. Only populated when the CRM API key's user wrote it or is an admin — otherwise null even if a note exists." },
                          "open_task_count": { "type": "integer", "description": "Open Tasks (Not Started / In Progress) linked to this Opportunity." },
                          "task_not_updated_count": { "type": "integer", "description": "Of open_task_count, how many aren't Active by the Activity panel's Task rule (touched within 7 days AND not overdue)." }
                        }
                      }
                    },
                    "task_total": { "type": "integer" },
                    "tasks": {
                      "type": "array",
                      "description": "Every open Task (Not Started / In Progress, related_object_type=Opportunity) whose Opportunity matched the row population above — Task List section of the Opportunity List tab. Worst first: inactive tasks before active, then by days_since_update descending.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "integer" },
                          "subject": { "type": "string" },
                          "status": { "type": "string", "description": "Not Started | In Progress." },
                          "owner_name": { "type": "string", "nullable": true },
                          "due_date": { "type": "string", "nullable": true },
                          "days_since_update": { "type": "integer", "nullable": true, "description": "Days since updated_at, falling back to created_at." },
                          "active": { "type": "boolean", "description": "Touched within 7 days AND not overdue — same rule as the Activity panel's Task side." },
                          "opportunity_id": { "type": "integer" },
                          "opportunity_name": { "type": "string", "nullable": true },
                          "opportunity_crm_url": { "type": "string" },
                          "opportunity_stage": { "type": "string" },
                          "opportunity_owner_name": { "type": "string", "nullable": true }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "502": { "description": "The CRM rejected the API key, or the background refresh's last attempt failed." },
          "503": { "description": "No data cached yet — retry shortly." }
        }
      }
    },
    "/{full_path}": {
      "get": {
        "summary": "Serves the Indonesia opportunity pipeline dashboard page for any path.",
        "operationId": "serve_dashboard",
        "parameters": [
          {
            "name": "full_path",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The dashboard HTML page.",
            "content": {
              "text/html": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
