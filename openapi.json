{
  "openapi": "3.0.3",
  "info": {
    "title": "Indonesia Pipeline Dashboard",
    "description": "Serves a dashboard of Ninja Van's all-time Indonesia sales opportunity pipeline (composition, aging, stage bottlenecks, forecast, team rollups, and Notebook activity), refreshed by a background job roughly every 15 minutes from the Ninja Van SalesCRM API — the full pull is ~73k records, too slow to run inside a request.",
    "version": "3.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Readiness probe used by the platform to confirm the backend is up.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The backend is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" }
                  },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    },
    "/api/pipeline": {
      "get": {
        "summary": "Returns aggregated Indonesia opportunity pipeline metrics from the last completed background refresh (roughly every 15 minutes), optionally filtered. Every metric in the response is recomputed against the filtered population — this isn't a separate filtered view of a fixed payload.",
        "operationId": "get_pipeline",
        "parameters": [
          { "name": "owners", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } }, "description": "Repeatable. Keep only deals (and Tasks) owned by one of these owner_names. OR within this filter." },
          { "name": "managers", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } }, "description": "Repeatable. Keep only deals (and Tasks) whose owner's Manager (per team_roster.json) is one of these. Deals owned by someone not in the roster never match." },
          { "name": "product_lines", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } }, "description": "Repeatable. Keep only deals whose nv_product_line is one of these. Does not filter Tasks." },
          { "name": "service_levels", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } }, "description": "Repeatable. Keep only deals whose service_level (multi-select) includes at least one of these. Does not filter Tasks." }
        ],
        "responses": {
          "200": {
            "description": "Aggregated pipeline metrics.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer", "description": "Every open Indonesia Opportunity (any age) plus any Opportunity created in the last 12 months (open or closed) — not the true all-time count of 72,721, which is too large to fetch per refresh." },
                    "created_this_month": { "type": "integer" },
                    "created_last_month": { "type": "integer" },
                    "open_pipeline": { "type": "integer" },
                    "open_active": { "type": "integer" },
                    "open_future": { "type": "integer" },
                    "closed_won": { "type": "integer" },
                    "closed_lost": { "type": "integer" },
                    "closed_total": { "type": "integer" },
                    "win_rate": { "type": "number" },
                    "lead_time_to_won_avg_days": { "type": "number", "nullable": true, "description": "Average days from created_at to the stage change that closed each Closed-Won deal (created_at stands in for a missing 'entered New stage' timestamp). Null if there are no Closed-Won deals in range." },
                    "lead_time_to_won_count": { "type": "integer", "description": "Number of Closed-Won deals included in the lead-time average." },
                    "revenue_potential_mth": { "type": "number" },
                    "revenue_committed_mth": { "type": "number" },
                    "open_stages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "count": { "type": "integer" }
                        }
                      }
                    },
                    "closed_stages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "count": { "type": "integer" }
                        }
                      }
                    },
                    "product_lines": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "count": { "type": "integer" }
                        }
                      }
                    },
                    "service_levels": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "count": { "type": "integer" }
                        }
                      }
                    },
                    "service_blank": { "type": "integer" },
                    "owners": {
                      "type": "array",
                      "description": "Owners ranked by open deal count, each with a days-since-creation bucket breakdown of their own open deals.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "count": { "type": "integer" },
                          "buckets": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "label": { "type": "string" },
                                "count": { "type": "integer" }
                              }
                            }
                          }
                        }
                      }
                    },
                    "aging_buckets": {
                      "type": "array",
                      "description": "Open deals bucketed by days since creation.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": { "type": "string" },
                          "count": { "type": "integer" }
                        }
                      }
                    },
                    "stage_duration": {
                      "type": "array",
                      "description": "Average days open deals have sat in each current stage, longest first.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "avg_days": { "type": "number" },
                          "count": { "type": "integer" }
                        }
                      }
                    },
                    "stage_duration_buckets": {
                      "type": "array",
                      "description": "Open deals bucketed by days since their last stage change.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": { "type": "string" },
                          "count": { "type": "integer" }
                        }
                      }
                    },
                    "stage_duration_grid": {
                      "type": "array",
                      "description": "For each stage, its open deals broken down by days-since-last-stage-change bucket.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "stage": { "type": "string" },
                          "total": { "type": "integer" },
                          "buckets": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "label": { "type": "string" },
                                "count": { "type": "integer" }
                              }
                            }
                          }
                        }
                      }
                    },
                    "aging_grid": {
                      "type": "array",
                      "description": "For each days-since-creation bucket, open deals broken down by current stage.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": { "type": "string" },
                          "total": { "type": "integer" },
                          "stages": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "name": { "type": "string" },
                                "count": { "type": "integer" }
                              }
                            }
                          }
                        }
                      }
                    },
                    "forecast": {
                      "type": "array",
                      "description": "Open deals by expected close date: a leading 'overdue' bucket (close date already passed), then one bucket per month from the current month through the furthest expected close date in the data. Each bucket is broken down by stage and revenue.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": { "type": "string", "example": "2026-09", "description": "\"overdue\" or a YYYY-MM month key." },
                          "count": { "type": "integer" },
                          "revenue": { "type": "number" },
                          "stages": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "name": { "type": "string" },
                                "count": { "type": "integer" },
                                "revenue": { "type": "number" }
                              }
                            }
                          }
                        }
                      }
                    },
                    "forecast_undated_count": {
                      "type": "integer",
                      "description": "Open deals with no expected close date, excluded from the forecast."
                    },
                    "created_by_month": {
                      "type": "object",
                      "description": "Opportunities created per month, rolled up by Manager and by individual owner (Active-rep team roster). Each rep has a 10-per-month target; a manager's target is 10 x their headcount.",
                      "properties": {
                        "months": { "type": "array", "items": { "type": "string" }, "description": "Sorted ascending — the last element is the current month." },
                        "by_manager": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": { "type": "string" },
                              "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
                              "total": { "type": "integer" },
                              "target": { "type": "integer", "nullable": true, "description": "10 x headcount reporting to this manager. Null for the 'Unmapped' bucket." }
                            }
                          }
                        },
                        "by_owner": {
                          "type": "array",
                          "description": "One row per Active rep, including reps with 0 created this window.",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": { "type": "string" },
                              "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
                              "total": { "type": "integer" },
                              "target": { "type": "integer", "description": "Always 10." }
                            }
                          }
                        },
                        "unmapped_owner_count": { "type": "integer" }
                      }
                    },
                    "activity_summary": {
                      "type": "array",
                      "description": "Open deals bucketed by days since their Notebook was last touched (falls back to created_at if never touched). Reps are expected to add a Notebook entry at least every 7 days.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": { "type": "string", "example": "< 7d" },
                          "color": { "type": "string", "example": "good", "description": "good | warning | orange | critical" },
                          "count": { "type": "integer" }
                        }
                      }
                    },
                    "activity_touched_pct": {
                      "type": "number",
                      "description": "Percent of open opportunities whose Notebook was touched within the last 7 days."
                    },
                    "activity_by_owner": {
                      "type": "array",
                      "description": "Per-owner breakdown of the same staleness buckets, sorted worst (most 30d+) first.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
                          "total": { "type": "integer" },
                          "touched_pct": { "type": "number", "description": "This owner's own percent touched within 7 days." }
                        }
                      }
                    },
                    "activity_undated_count": {
                      "type": "integer",
                      "description": "Open deals with neither a Notebook entry nor a created_at (should be ~0)."
                    },
                    "task_total": { "type": "integer", "description": "Open (Not Started / In Progress) Task records owned by reps in the team roster." },
                    "task_active_total": { "type": "integer", "description": "Of task_total, how many were touched (updated_at, falling back to created_at) within the last 7 days and aren't overdue." },
                    "task_activity_pct": { "type": "number" },
                    "task_activity_by_owner": {
                      "type": "array",
                      "description": "Per-owner open Task counts and the same 'active' definition, sorted worst (lowest active_pct) first.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "total": { "type": "integer" },
                          "active": { "type": "integer" },
                          "active_pct": { "type": "number" }
                        }
                      }
                    },
                    "task_unmapped_reps": {
                      "type": "array",
                      "description": "Roster names with no CRM owner_id on file — their Tasks can't be queried at all.",
                      "items": { "type": "string" }
                    },
                    "crm_updated_pct": { "type": "number", "description": "The final Activity KPI: (Notebook <7d count + Task Active count) / (total open deals + total open Tasks), summed rather than averaged." },
                    "crm_updated_numerator": { "type": "integer" },
                    "crm_updated_denominator": { "type": "integer" },
                    "crm_updated_by_owner": {
                      "type": "array",
                      "description": "Per-owner version of crm_updated_pct, sorted worst first.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "updated": { "type": "integer" },
                          "total": { "type": "integer" },
                          "pct": { "type": "number" }
                        }
                      }
                    },
                    "snapshot_at": { "type": "string", "format": "date-time" },
                    "filter_options": {
                      "type": "object",
                      "description": "Dropdown choices for the filter bar, always computed from the full unfiltered population regardless of the filters applied to this request.",
                      "properties": {
                        "owners": { "type": "array", "items": { "type": "string" } },
                        "managers": { "type": "array", "items": { "type": "string" } },
                        "product_lines": { "type": "array", "items": { "type": "string" } },
                        "service_levels": { "type": "array", "items": { "type": "string" } }
                      }
                    },
                    "viewer_name": { "type": "string", "nullable": true, "description": "The requester's team-roster name, resolved from the platform's X-Forwarded-Email header via a TEAM_EMAIL_MAP env var. Null if unmapped or SSO isn't the access method." },
                    "viewer_scoped": { "type": "boolean", "description": "True if viewer_name was resolved and the response was restricted to their own pipeline (or their team's, if they're a Manager/Sales Head)." }
                  }
                }
              }
            }
          },
          "502": { "description": "The CRM rejected the API key, or the background refresh's last attempt failed." },
          "503": { "description": "No data cached yet — the background refresh (fetches ~73k records, can take a few minutes) hasn't completed its first run since the app started. Retry shortly." }
        }
      }
    },
    "/{full_path}": {
      "get": {
        "summary": "Serves the Indonesia opportunity pipeline dashboard page for any path.",
        "operationId": "serve_dashboard",
        "parameters": [
          {
            "name": "full_path",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The dashboard HTML page.",
            "content": {
              "text/html": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
